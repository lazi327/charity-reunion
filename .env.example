# 环境变量清单(参考用)。Spring Boot 与 node 都不会自动读取本文件:
# 本地按 README 第三节用 $env: / export 设置,线上在平台(如 Railway)的 Variables 面板填写。
# 复制为 .env 仅作记录,.gitignore 已忽略 .env。

# ---- 后端 server/ (Spring Boot) ----
# 平台会注入 PORT;本地不设则用 8081
PORT=8081
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cf_reunion
DB_USERNAME=root
DB_PASSWORD=root
# 生产务必换成 >= 32 字节的随机串
JWT_SECRET=charity-dating-jwt-secret-key-please-change-me-2026
# 图片上传目录;平台挂 volume 时指向挂载点,否则重新部署会丢图
UPLOAD_DIR=./upload

# ---- 前端 web/ (node server.mjs) ----
# 平台会注入 PORT;API_TARGET 指向后端,走平台内网地址即可
API_TARGET=http://localhost:8081
